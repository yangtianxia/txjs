{
  "name": "avero",
  "version": "0.1.0",
  "description": "A lightweight form validation library with multi-rule support and flexible extension",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.min.js",
  "jsdelivr": "./dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.mjs",
      "require": "./dist/defaults.cjs"
    },
    "./locale/zhCN": {
      "types": "./dist/locale/zhCN.d.ts",
      "import": "./dist/locale/zhCN.mjs",
      "require": "./dist/locale/zhCN.cjs"
    },
    "./locale/enUS": {
      "types": "./dist/locale/enUS.d.ts",
      "import": "./dist/locale/enUS.mjs",
      "require": "./dist/locale/enUS.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "eslint ./src --ext .ts",
    "format": "prettier ./src --write",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangtianxia/avero.git"
  },
  "keywords": [
    "avero",
    "validator",
    "form",
    "validation",
    "typescript"
  ],
  "license": "MIT",
  "author": "yangtianxia <1304082170@qq.com>",
  "bugs": {
    "url": "https://github.com/yangtianxia/avero/issues"
  },
  "homepage": "https://github.com/yangtianxia/avero#readme",
  "dependencies": {
    "@txjs/bool": "^1.0.6",
    "@txjs/shared": "^1.0.10",
    "extend": "^3.0.2"
  },
  "devDependencies": {
    "@types/extend": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.12"
  }
}
